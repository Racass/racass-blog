---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="hero">
				<h1>Ideias, pesquisa e recursos para aprender.</h1>
				<p class="introduction">
					Um espaço para materiais didáticos, artigos técnicos, projetos, tutoriais e o que mais
					vier na minha cabeça.
				</p>
				<div class="actions">
					<a class="primary" href={`${base}about/`}>Sobre mim</a>
					<a href={`${base}blog/`}>Ler artigos</a>
				</div>
			</section>
			<section class="areas" aria-label="Áreas">
				<article>
					<h2>Materiais didáticos</h2>
					<p>Conteúdos, exercícios, referências e recursos para apoiar o ensino e a aprendizagem.</p>
				</article>
				<article>
					<h2>Artigos e tutoriais</h2>
					<p>Textos técnicos, guias práticos e anotações sobre assuntos que estou estudando.</p>
				</article>
				<article>
					<h2>Projetos e ideias</h2>
					<p>Experimentos, projetos em andamento e tudo mais que vier na minha cabeça.</p>
				</article>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home {
		width: 1080px;
		padding-top: 6rem;
	}
	.hero {
		max-width: 820px;
	}
	h1 {
		font-size: clamp(3rem, 8vw, 5.5rem);
		letter-spacing: -0.045em;
	}
	.introduction {
		max-width: 680px;
		color: rgb(var(--gray));
		font-size: 1.35rem;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 2rem;
	}
	.actions a {
		padding: 0.65rem 1.1rem;
		border: 1px solid var(--accent);
		border-radius: 999px;
		text-decoration: none;
	}
	.actions .primary {
		background: var(--accent);
		color: white;
	}
	.areas {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
		margin-top: 7rem;
	}
	.areas article {
		padding: 1.5rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 18px;
		background: rgba(255, 255, 255, 75%);
	}
	.areas h2 {
		font-size: 1.35rem;
	}
	.areas p {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 1rem;
	}
	@media (max-width: 720px) {
		.home {
			padding-top: 3rem;
		}
		.areas {
			grid-template-columns: 1fr;
			margin-top: 4rem;
		}
	}
</style>
