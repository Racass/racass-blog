---
import ConsentBanner from './ConsentBanner.astro';

const today = new Date();
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<footer>
	<span>&copy; {today.getFullYear()} Professor Engenheiro Rafael Feliciano Cassiolato.</span>
	<a
		href="https://www.linkedin.com/in/rafael-cassiolato/"
		target="_blank"
		rel="noreferrer"
		aria-label="LinkedIn de Rafael Cassiolato"
	>
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<path
				fill="currentColor"
				d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V8.98h3.41v1.57h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.29ZM5.32 7.41a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12Zm1.78 13.04H3.54V8.98H7.1v11.47ZM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.73V1.73C24 .77 23.21 0 22.23 0Z"
			></path>
		</svg>
	</a>
	<span>Desenvolvido com Astro.</span>
	<a href={`${base}privacidade/`}>Privacidade</a>
	<button type="button" data-open-consent>Preferências de métricas</button>
</footer>
<ConsentBanner />
<style>
	footer {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.45rem;
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	footer a,
	footer button {
		display: inline-flex;
		color: rgb(var(--gray));
	}
	footer a:hover,
	footer button:hover {
		color: #0a66c2;
	}
	footer button {
		padding: 0;
		border: 0;
		background: transparent;
		font: inherit;
		text-decoration: underline;
		cursor: pointer;
	}
	footer svg {
		width: 1.1em;
		height: 1.1em;
	}
</style>
