---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const normalizePath = (path: string) => {
	const relativePath = path.replace(import.meta.env.BASE_URL, '').replace(/^\/+|\/+$/g, '');
	return relativePath ? `/${relativePath}` : '/';
};
const pathname = normalizePath(Astro.url.pathname);
const targetPath = normalizePath(String(href));
const subpath = pathname.match(/[^\/]+/g);
const isActive = targetPath === pathname || targetPath === '/' + (subpath?.[0] || '');
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
